#!/bin/bash

PLACE="./place.py"

find input -type f -name '*.html' -print0 |
while IFS= read -r -d '' HTML; do

  DIR="$(dirname "$HTML")"
  NAME="$(basename "$HTML" .html)"

  # Only process directories containing matching HTML and YAML
  if [ -f "$DIR/$NAME.yaml" ]; then

    echo
    echo "========================================"
    echo "Processing: $DIR"
    echo "========================================"

    "$PLACE" "$DIR" || exit 1

  fi

done

# ==========================================================
# POST-PROCESSING: Move output/main/* to output/
# ==========================================================

if [ -d "output/main" ]; then
  echo
  echo "========================================"
  echo "Flattening output/main into output/"
  echo "========================================"

  # Enable dotglob to include hidden files if any exist
  shopt -s dotglob nullglob
  
  mv output/main/* output/ 2>/dev/null
  rmdir output/main 2>/dev/null

  shopt -u dotglob nullglob
fi
