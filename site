#!/bin/bash

# Ensure script is run as root
if [ "$EUID" -ne 0 ]; then
  echo "[-] Error: This script must be run as root." >&2
  exit 1
fi

PLACE="./place.py"

find input -type f -name '*.html' -print0 |
while IFS= read -r -d '' HTML; do

  DIR="$(dirname "$HTML")"
  NAME="$(basename "$HTML" .html)"

  # Only process directories containing matching HTML and YAML
  if [ -f "$DIR/$NAME.yaml" ]; then

    echo
    echo "========================================"
    echo "Processing: $DIR"
    echo "========================================"

    "$PLACE" "$DIR" || exit 1

  fi

done

# ==========================================================
# POST-PROCESSING: Move output/main/* to output/
# ==========================================================

if [ -d "output/main" ]; then
  echo
  echo "========================================"
  echo "Flattening output/main into output/"
  echo "========================================"

  # Enable dotglob to include hidden files if any exist
  shopt -s dotglob nullglob
  
  mv output/main/* output/ 2>/dev/null
  rmdir output/main 2>/dev/null

  shopt -u dotglob nullglob
fi

echo "Fixing Relative Paths"
./fix_paths.py

find /var/www/adamfistler.com/public_html -type f -exec chmod 644 {} +

# Set ownership of created files/folders to apfistler:user
echo "Setting ownership to apfistler:user..."
chown -R apfistler:user output/ /var/www/adamfistler.com/public_html

# Fork off cache control generation and Apache restart into the background
echo "Forking cache control and Apache restart..."
(
  ./cache_control_manifest.py
  systemctl restart apache2
) &
disown

echo "Deployment steps complete. Background cache/restart tasks initiated."
