#!/usr/bin/env python3

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))

from image_annotator.config import load_config
from image_annotator.document import load_document
from image_annotator.images import (
  find_images,
  get_image_src,
  image_exists,
  image_size,
  resolve_image_path,
)

def main():
  if len(sys.argv) != 2:
    print(f"Usage: {sys.argv[0]} <html-file>")
    sys.exit(1)

  filename = sys.argv[1]

  config_file = os.path.join(
    os.path.dirname(__file__),
    "..",
    "etc",
    "config.yaml"
  )

  config = load_config(config_file)
  document = load_document(filename)
  images = find_images(document)
  
  print(f"Loaded: {filename}")
  print(f"Title: {document.title.string if document.title else '(none)'}")
  
  print(f"Images: {len(images)}")

  for image in images:
    src = get_image_src(image)
    path = resolve_image_path(config, src)

    print(src)
    print(path)

    if image_exists(path):
      print("Exists: yes")
      print(f"Size: {image_size(path) // 1024} KB")
    else:
      print("Exists: no")

if __name__ == "__main__":
  main()
